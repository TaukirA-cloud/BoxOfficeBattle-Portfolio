# npm start, npm run dev, and npm run movies:sync load .env automatically.
# Obtain a free non-commercial API Read Access Token at:
# https://www.themoviedb.org/settings/api
# Do not use your account password or the shorter v3 API key here.
TMDB_READ_ACCESS_TOKEN=
# Import target, not a guaranteed count: only movies with usable posters and positive revenue qualify.
TMDB_MAX_MOVIES=5000
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=var/battle.sqlite
# Required when NODE_ENV=production. Serve behind an HTTPS reverse proxy.
# APP_ORIGIN=https://your-domain.example
# NODE_ENV=production
# Optional private operational metrics. Use a long random secret.
# METRICS_TOKEN=
# Enable ONLY behind a private proxy that replaces X-Forwarded-For.
# TRUST_PROXY=1

# Ads stay OFF by default; verification works through the meta tag and /ads.txt.
# Before enabling: finish AdSense review, turn off Auto ads, configure Google's
# required consent messages, and confirm commercial movie-data/image rights.
# Only the three editorial articles support a manual responsive display unit.
# ADSENSE_ENABLED=1
# ADSENSE_SLOT=1234567890
